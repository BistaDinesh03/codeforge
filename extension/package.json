{
  "name": "codetalk",
  "displayName": "CodeTalk",
  "description": "If your code could talk, what would it say?",
  "version": "1.0.0",
  "publisher": "codetalk",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeTalk",
      "properties": {
        "codetalk.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of your CodeTalk server"
        }
      }
    },
    "commands": [
      {
        "command": "codetalk.open",
        "title": "CodeTalk: Open Dashboard"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0"
  }
}