{
  "name": "codeforge",
  "displayName": "CodeForge",
  "description": "Turn your Android phone into a private AI coding server",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeforge.connect",
        "title": "CodeForge: Connect to Android"
      },
      {
        "command": "codeforge.start",
        "title": "CodeForge: Open Chat"
      },
      {
        "command": "codeforge.disconnect",
        "title": "CodeForge: Disconnect from Android"
      },
      {
        "command": "codeforge.explainCode",
        "title": "CodeForge: Explain Code"
      },
      {
        "command": "codeforge.generateCode",
        "title": "CodeForge: Generate Code"
      },
      {
        "command": "codeforge.rewriteCode",
        "title": "CodeForge: Rewrite Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeforge.explainCode",
          "when": "editorHasSelection",
          "group": "codeforge"
        },
        {
          "command": "codeforge.generateCode",
          "group": "codeforge"
        },
        {
          "command": "codeforge.rewriteCode",
          "when": "editorHasSelection",
          "group": "codeforge"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0"
  }
}